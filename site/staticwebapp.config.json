{
  "platform": { "apiRuntime": "python:3.11" },
  "responseOverrides": {
    "404": { "rewrite": "/404.html" }
  },
  "mimeTypes": {
    ".geojson": "application/geo+json",
    ".bin": "application/octet-stream",
    ".csv": "text/csv; charset=utf-8",
    ".md": "text/markdown; charset=utf-8",
    ".woff2": "font/woff2"
  },
  "globalHeaders": {
    "Cache-Control": "public, max-age=600"
  }
}
