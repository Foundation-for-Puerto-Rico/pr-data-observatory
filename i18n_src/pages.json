  "data_labels": [
    {
      "file": "places.json",
      "paths": [
        "[].type"
      ],
      "pages": [
        "map",
        "threed"
      ]
    },
    {
      "file": "economy_series.json",
      "paths": [
        "vars[].label",
        "vars[].group",
        "vars[].unit"
      ],
      "pages": [
        "map"
      ]
    },
    {
      "file": "housing_series.json",
      "paths": [
        "vars[].label",
        "vars[].group",
        "vars[].unit"
      ],
      "pages": [
        "map",
        "housing"
      ]
    },
    {
      "file": "population_series.json",
      "paths": [
        "vars[].label",
        "vars[].unit"
      ],
      "pages": [
        "map"
      ]
    },
    {
      "file": "population_series.json",
      "paths": [
        "vars[].group"
      ],
      "prefixes": [
        "Population · "
      ],
      "pages": [
        "map"
      ]
    },
    {
      "file": "registry.json",
      "paths": [
        "growth_note"
      ],
      "pages": [
        "dictionary",
        "map"
      ]
    },
    {
      "file": "wanted.json",
      "paths": [
        "items[].theme"
      ],
      "pages": [
        "map"
      ]
    },
    {
      "file": "operators.json",
      "paths": [
        "live.sources[].name",
        "live.sources[].detail",
        "live.sources[].status"
      ],
      "pages": [
        "map"
      ]
    },
    {
      "file": "places.json",
      "paths": [
        "[].overture_category"
      ],
      "transform": "humanize",
      "pages": [
        "map"
      ]
    },
    {
      "file": "housing_series.json",
      "paths": [
        "notes.pop_break",
        "vars[].basis.*"
      ],
      "pages": [
        "housing"
      ]
    },
    {
      "file": "housing.json",
      "paths": [
        "lihtc[].type",
        "lihtc[].beneficiaries"
      ],
      "pages": [
        "housing"
      ]
    },
    {
      "file": "exposure_municipio.json",
      "paths": [
        "vars.*.label.en"
